# Copy to .env for local runs. In production set these as real environment variables.
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Model selection (default chosen by evaluation/model_comparison.py; see evaluation/model_selection.md)
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.5-flash-lite
ALTERNATE_MODELS=groq:openai/gpt-oss-120b
ENABLE_MODEL_FALLBACK=true

# Provider keys - leave blank here, never commit real values
GEMINI_API_KEY=
GROQ_API_KEY=

# Agent limits
MAX_STEPS=6
MAX_TOOL_RETRIES=2
MAX_DECISION_REPAIRS=2
MAX_OUTPUT_TOKENS=1024
MAX_RUN_TOKENS=40000
RUN_TIMEOUT_SECONDS=40
MODEL_TIMEOUT_SECONDS=15
MIN_MODEL_WINDOW_SECONDS=3
TOOL_TIMEOUT_SECONDS=2
MAX_EXTERNAL_CHARS=12000
MAX_HISTORY_MESSAGES=12

# Admission and spend controls
MAX_CONCURRENT_RUNS=4
ARENA_RATE_LIMIT_PER_MINUTE=60
CHAT_RATE_LIMIT_PER_MINUTE=20
DAILY_MODEL_CALL_LIMIT=3000
